body {
  margin: 0;
}

.top_border {
  height: 100px;
  background-color: rgb(16, 91, 126);
}



.The_boys{
   margin: 0;
  padding-left: 20px;
  padding-top: 20px;
} 

.HEADER {
  margin: 0;
  font-weight:900;
  font-size: larger;
  font-family: 'Courier New', Courier, monospace;
  padding-top: 20px;
  padding-left: 50px;
}

.categories {
     margin: 0;
 
  padding-bottom: 15px;
  padding-left: 50px;


}

.Bottom .bottom_border {
  height: 40px;
  background-color: rgb(16, 91, 126);
}

.content {
  padding: 0 40px 40px;
}

.tabs {
  display: flex;
  gap: 6px;
  border-bottom: 1px solid #244042;
}

.tab {
  font: inherit;
  font-size: 18px;
  color: #cfe3e1;
  background: none;
  border: 0;
  border-bottom: 3px solid transparent;
  padding: 12px 18px;
  cursor: pointer;
}

.tab.active {
  color: #4fc3c0;
  border-bottom-color: #4fc3c0;
  font-weight: 600;
}

.panel {
  background: #142729;
  border-radius: 14px;
  margin-top: 18px;
  overflow-x: auto;
}

.panel[hidden] {
  display: none;
}

table {
  width: 100%;
  border-collapse: collapse;
  color: #e6f1ef;
}

th, td {
  padding: 14px 16px;
  text-align: left;
  border-bottom: 1px solid #244042;
  white-space: nowrap;
}

th {
  color: #8fa9a8;
  font-size: 14px;
}

tr:last-child td {
  border-bottom: 0;
}

td a {
  color: #4fc3c0;
  text-decoration: none;
  font-weight: 600;
}

td a:hover {
  text-decoration: underline;
}

.filters {
  margin: 0;
  padding-left: 20px;
  padding-top: 20px;
 
}
